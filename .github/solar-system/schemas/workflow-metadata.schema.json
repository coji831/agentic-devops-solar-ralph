{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solar-ralph/schemas/workflow-metadata.schema.json",
  "title": "SOLAR Workflow Metadata (Minimal)",
  "description": "Minimal metadata contract for .github/workflows/*.workflow.md frontmatter. Validation is warning-only in setup/bootstrap.",
  "type": "object",
  "additionalProperties": true,
  "required": ["name", "type", "loop", "max_iterations", "exit_condition"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": ["knowledge", "simple-fix", "bug-fix", "feature"]
    },
    "loop": {
      "type": "boolean"
    },
    "max_iterations": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "exit_condition": {
      "type": "string",
      "minLength": 1
    }
  }
}
